# Supabase — Project Settings → API (all keys must be from the same project)
NEXT_PUBLIC_SUPABASE_URL=
# Legacy JWT anon key (recommended for SSR) — starts with eyJ...
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Or new publishable key — starts with sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy JWT service_role key — starts with eyJ...
SUPABASE_SERVICE_ROLE_KEY=
# Or new secret key — starts with sb_secret_...
SUPABASE_SECRET_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PREMIUM_SUBSCRIPTION_PRICE_ID=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=Firefly <noreply@firefly.app>
# Plain address for Supabase Auth SMTP (extract from RESEND_FROM_EMAIL)
RESEND_SMTP_ADMIN_EMAIL=

# Support (shown on business Contact page; messages emailed here)
SUPPORT_EMAIL=support@firefly.app
SUPPORT_PHONE=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Use mock data for all reads (preview UI without a populated database)
NEXT_PUBLIC_USE_MOCK_DATA=true

# Newsletter unsubscribe link HMAC (falls back to CRON_SECRET / service role key)
NEWSLETTER_UNSUBSCRIBE_SECRET=

# Cron (Vercel)
CRON_SECRET=
