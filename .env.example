# Supabase — Project Settings → API (all keys must be from the same project)
NEXT_PUBLIC_SUPABASE_URL=
# Legacy JWT anon key (recommended for SSR) — starts with eyJ...
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Or new publishable key — starts with sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy JWT service_role key — starts with eyJ...
SUPABASE_SERVICE_ROLE_KEY=
# Or new secret key — starts with sb_secret_...
SUPABASE_SECRET_KEY=

# Stripe
STRIPE_SECRET_KEY=
# Local: paste the whsec_ printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# Production: use the signing secret from the Dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Recurring Premium: 500 RON / month Price ID from Stripe Dashboard
STRIPE_PREMIUM_SUBSCRIPTION_PRICE_ID=
# One-time Premium: 500 RON Price ID (optional; falls back to inline price_data)
STRIPE_PREMIUM_ONETIME_PRICE_ID=
# Stripe Dashboard (manual):
# 1. Create product "Firefly Premium" with 500 RON one-time + 500 RON/month prices.
# 2. Enable Smart Retries; after all retries fail, mark the subscription unpaid (do not auto-cancel).
# 3. Customer Portal: payment-method update, invoices, cancel at period end. Return URL: /{locale}/business/promotions
# 4. Webhook /api/webhooks/stripe must include invoice.payment_failed plus checkout/invoice/subscription events.
# 5. Enable RON on the Stripe account.

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=Firefly <noreply@firefly.app>
# Plain address for Supabase Auth SMTP (extract from RESEND_FROM_EMAIL)
RESEND_SMTP_ADMIN_EMAIL=

# Support (shown on business Contact page; messages emailed here)
SUPPORT_EMAIL=support@firefly.app
SUPPORT_PHONE=

# Legal operator identity (footer + privacy / terms pages)
NEXT_PUBLIC_LEGAL_NAME=FIREFLY CONCEPT SRL
NEXT_PUBLIC_LEGAL_CUI=54945577
NEXT_PUBLIC_LEGAL_TRADE_REGISTER=J2026039957007
NEXT_PUBLIC_LEGAL_ADDRESS=Municipiul Pitești, Jud. Argeș, Strada Constructorilor, Nr. 11, Bl. C, Scara B, Etaj PARTER, Ap. 3
NEXT_PUBLIC_LEGAL_EMAIL=contact@fireflyapp.ro
NEXT_PUBLIC_LEGAL_PHONE=
# Optional — shown in footer only when set
NEXT_PUBLIC_LEGAL_CAEN=
NEXT_PUBLIC_LEGAL_AUTHORIZATIONS=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Use mock data for all reads (preview UI without a populated database)
NEXT_PUBLIC_USE_MOCK_DATA=true

# Newsletter unsubscribe link HMAC (falls back to CRON_SECRET / service role key)
NEWSLETTER_UNSUBSCRIBE_SECRET=

# Cron (Vercel)
CRON_SECRET=
