# Supabase — Project Settings → API (all keys must be from the same project)
NEXT_PUBLIC_SUPABASE_URL=
# Legacy JWT anon key (recommended for SSR) — starts with eyJ...
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Or new publishable key — starts with sb_publishable_...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy JWT service_role key — starts with eyJ...
SUPABASE_SERVICE_ROLE_KEY=
# Or new secret key — starts with sb_secret_...
SUPABASE_SECRET_KEY=

# Stripe
STRIPE_SECRET_KEY=
# Local: paste the whsec_ printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# Production: use the signing secret from the Dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Recurring Premium: 500 RON / month Price ID
STRIPE_PREMIUM_SUBSCRIPTION_PRICE_ID=
# One-time Premium: 500 RON Price ID (optional; falls back to inline price_data)
STRIPE_PREMIUM_ONETIME_PRICE_ID=
# One-time promotions (RON). Create/sync with:
#   npm run stripe:sync-promotions
#   node scripts/stripe-sync-promotion-products.mjs --env-file=.env.local
STRIPE_EVENT_BOOST_PRICE_ID=
STRIPE_FEED_POST_PRICE_ID=
STRIPE_NEWSLETTER_PRICE_ID=
STRIPE_SOCIAL_MEDIA_PRICE_ID=
# Stripe Dashboard (live Production / test Preview):
# 1. Catalog: Firefly Premium 500 RON one-time + monthly, plus promotion prices (script above).
# 2. Smart Retries: https://dashboard.stripe.com/revenue_recovery/retries
#    After retries fail, mark the subscription unpaid (do not auto-cancel):
#    https://dashboard.stripe.com/settings/billing/automatic
# 3. Customer Portal: payment-method update, invoices, cancel at period end.
#    Return URL: /{locale}/business/promotions
#    https://dashboard.stripe.com/settings/billing/portal
# 4. Production webhook: https://fireflyapp.ro/api/webhooks/stripe
#    Events: checkout.session.completed, invoice.payment_succeeded,
#    invoice.payment_failed, customer.subscription.created/updated/deleted
# 5. Enable RON on the Stripe account. Live keys on Vercel Production only.
# Production live price IDs (FIREFLY CONCEPT S.R.L. live account):
#   STRIPE_EVENT_BOOST_PRICE_ID=price_1UGONq0ku7q9iaLSkxfoOeEa
#   STRIPE_FEED_POST_PRICE_ID=price_1UGOPg0ku7q9iaLS8J0TZRHy
#   STRIPE_NEWSLETTER_PRICE_ID=price_1UGOO30ku7q9iaLSDr74ZpXZ
#   STRIPE_SOCIAL_MEDIA_PRICE_ID=price_1UGOPh0ku7q9iaLSlCRdgj0M
#   STRIPE_PREMIUM_ONETIME_PRICE_ID=price_1UGOPs0ku7q9iaLSOIAQmPL2
#   STRIPE_PREMIUM_SUBSCRIPTION_PRICE_ID=price_1UGOPs0ku7q9iaLSHLh7ujsn

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=Firefly <noreply@fireflyapp.ro>
# Plain address for Supabase Auth SMTP (extract from RESEND_FROM_EMAIL)
RESEND_SMTP_ADMIN_EMAIL=noreply@fireflyapp.ro

# Support (shown on business Contact page; messages emailed here)
SUPPORT_EMAIL=support@firefly.app
SUPPORT_PHONE=

# Legal operator identity (footer + privacy / terms pages)
NEXT_PUBLIC_LEGAL_NAME=FIREFLY CONCEPT SRL
NEXT_PUBLIC_LEGAL_CUI=54945577
NEXT_PUBLIC_LEGAL_TRADE_REGISTER=J2026039957007
NEXT_PUBLIC_LEGAL_ADDRESS=Municipiul Pitești, Jud. Argeș, Strada Constructorilor, Nr. 11, Bl. C, Scara B, Etaj PARTER, Ap. 3
NEXT_PUBLIC_LEGAL_EMAIL=contact@fireflyapp.ro
NEXT_PUBLIC_LEGAL_PHONE=
# Optional — shown in footer only when set
NEXT_PUBLIC_LEGAL_CAEN=
NEXT_PUBLIC_LEGAL_AUTHORIZATIONS=

# App
# Production (Vercel Production): https://fireflyapp.ro
# Staging (Vercel Preview / develop): https://firefly-git-develop-fireflydev.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Use mock data for all reads (preview UI without a populated database)
NEXT_PUBLIC_USE_MOCK_DATA=true

# Environments (Vercel)
# Production and Preview MUST use different Supabase projects.
# Production: llpwwvlvxdqpbcrvwvgs (fireflyapp.ro) — live data, no demo seed
# Preview/develop: FireFly Staging — current demo/test dataset
# Stripe: live keys on Production only; test keys on Preview
# Cron jobs in vercel.json run on Production only

# Local targeting
# .env.local          production (or local) keys
# .env.staging.local  staging keys (gitignored; preferred by db:seed-demo)

# Pre-launch countdown is controlled from Admin → Settings.
# These env vars are a fallback only if the database is unreachable.
# NEXT_PUBLIC_LAUNCH_AT=2026-09-06T21:00:00+03:00
# NEXT_PUBLIC_PRELAUNCH_MODE=auto

# Newsletter unsubscribe link HMAC (falls back to CRON_SECRET / service role key)
NEWSLETTER_UNSUBSCRIBE_SECRET=

# Cron (Vercel)
CRON_SECRET=
